# Copy to .env. Admin Wi-Fi always uses password123.
AP_IFACE=wlan0
ADMIN_IFACE=wlan1
INTERNET_IFACE=eth0
# Optional guard against assigning the admin role to the wrong USB adapter.
# ADMIN_WIFI_MAC=38:a2:8c:a2:1f:c9
SSID=Infrareveal
ADMIN_SSID=Infrareveal-admin
WIFI_COUNTRY=SE
AP_CHANNEL=1
ADMIN_CHANNEL=6
# Private /24 prefixes. These must not overlap each other or uplink routes.
AP_PREFIX=10.0.0
ADMIN_PREFIX=10.77.0
DATA_DIR=./data
GEOIP_DIR=./geoip
# Uncomment to serve the debug dashboard on the admin network at port 8081.
# COMPOSE_PROFILES=debug

# Unattended lab display at http://10.77.0.1/demo (opt-in).
# Enabling creates/resumes a dedicated session and closes other active sessions.
DEMO_MODE=false
DEMO_RETENTION_MINUTES=30
DEMO_DOMAIN_CATALOGUE=true
