# Copy to .env. One shared Wi-Fi serves participants and visiting display devices.
AP_IFACE=wlan0
# No USB radio required. Choose display mode at http://infrareveal.home.arpa.
ADMIN_WIFI_ENABLED=false
DASHBOARD_ON_AP=true
ADMIN_IFACE=wlan1
INTERNET_IFACE=eth0
# Optional guard against assigning the admin role to the wrong USB adapter.
# ADMIN_WIFI_MAC=38:a2:8c:a2:1f:c9
SSID=Infrareveal
ADMIN_SSID=Infrareveal-admin
WIFI_COUNTRY=SE
AP_CHANNEL=1
ADMIN_CHANNEL=6
# Private /24 prefixes. These must not overlap each other or uplink routes.
AP_PREFIX=10.0.0
ADMIN_PREFIX=10.77.0
DATA_DIR=./data
GEOIP_DIR=./geoip
# Uncomment to serve the debug dashboard at port 8081 on the shared Wi-Fi.
# COMPOSE_PROFILES=debug

# Unattended lab session at http://infrareveal.home.arpa/demo (opt-in).
# Enabling creates/reuses the active continuous session and closes other active sessions.
DEMO_MODE=false
DEMO_RETENTION_MINUTES=30
# Seven core collections. Full diagnostics adds three optional collections.
DIAGNOSTICS_ENABLED=false
DIAGNOSTICS_RETENTION_MINUTES=60
DIAGNOSTICS_MAX_MB=16
TRAFFIC_CHUNK_MS=5000
TRAFFIC_BUCKET_MS=50
TRAFFIC_FLUSH_MS=400
TRAFFIC_CORRECTION_MS=10000
ACTIVITY_QUIET_GAP_MS=45000

# Optional City database path inside the gateway. The default matches GEOIP_DIR.
# Configure MaxMind account credentials from Dashboard > Storage & maintenance.
GEOIP_CITY_DB=/root/geoip/city.mmdb
